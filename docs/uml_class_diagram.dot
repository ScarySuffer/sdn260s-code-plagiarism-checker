digraph G {
rankdir=TB; nodesep=0.45; ranksep=0.7; splines=ortho; fontname="Helvetica";
node [shape=plain fontname="Helvetica" fontsize=10];
edge [fontname="Helvetica" fontsize=9];
"Main" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f1fb"><TR><TD><B>Main</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT">main(args: String[])<BR ALIGN="LEFT"/>run(args, out, logger): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CLI" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f1fb"><TR><TD><B>CLI</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-in: Scanner<BR ALIGN="LEFT"/>-out: PrintStream<BR ALIGN="LEFT"/>-service: ComparisonService<BR ALIGN="LEFT"/>-reportGenerator: ReportGenerator<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">run()<BR ALIGN="LEFT"/>-printMenu()<BR ALIGN="LEFT"/>-addSubmissions()<BR ALIGN="LEFT"/>-viewSubmissions()<BR ALIGN="LEFT"/>-compare()<BR ALIGN="LEFT"/>-viewResults()<BR ALIGN="LEFT"/>-generateReport()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ComparisonService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f1fb"><TR><TD><B>ComparisonService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-logger: Logger<BR ALIGN="LEFT"/>-reader: FileReader<BR ALIGN="LEFT"/>-processor: CodeProcessor<BR ALIGN="LEFT"/>-tokenizer: CodeTokenizer<BR ALIGN="LEFT"/>-checker: SimilarityChecker<BR ALIGN="LEFT"/>-threads: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">load(paths): List&lt;CodeFile&gt;<BR ALIGN="LEFT"/>compare(files): List&lt;SimilarityResult&gt;<BR ALIGN="LEFT"/>getChecker()<BR ALIGN="LEFT"/>getThreads()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FileReader" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f1fb"><TR><TD><B>FileReader</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-logger: Logger<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">readFile(path): CodeFile<BR ALIGN="LEFT"/>scanFolder(folder): List&lt;CodeFile&gt;<BR ALIGN="LEFT"/>-scanRecursively(folder, found)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CodeFile" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eaf7ea"><TR><TD><B>CodeFile</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-path: Path<BR ALIGN="LEFT"/>-content: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">getPath()<BR ALIGN="LEFT"/>getName()<BR ALIGN="LEFT"/>getContent()<BR ALIGN="LEFT"/>getLineCount()<BR ALIGN="LEFT"/>equals() / hashCode()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CodeProcessor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f1fb"><TR><TD><B>CodeProcessor</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT">normalise(file: CodeFile): String<BR ALIGN="LEFT"/>normalise(source: String): String<BR ALIGN="LEFT"/>stripComments(s): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CodeTokenizer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f1fb"><TR><TD><B>CodeTokenizer</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-KEYWORDS: Set&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">tokenise(code: String): List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SimilarityChecker" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f1fb"><TR><TD><B>SimilarityChecker</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-gramSize: int = 3<BR ALIGN="LEFT"/>-thresholdPercent: double = 70<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">compare(a, tokensA, b, tokensB): SimilarityResult<BR ALIGN="LEFT"/>compareAll(files, processor, tokenizer): List<BR ALIGN="LEFT"/>compareAll(..., threads): List<BR ALIGN="LEFT"/>-grams(tokens)<BR ALIGN="LEFT"/>-fragments(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SimilarityResult" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eaf7ea"><TR><TD><B>SimilarityResult</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-fileA: CodeFile<BR ALIGN="LEFT"/>-fileB: CodeFile<BR ALIGN="LEFT"/>-similarityPercent: double<BR ALIGN="LEFT"/>-matchingFragments: List&lt;String&gt;<BR ALIGN="LEFT"/>-flagged: boolean<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">getSimilarityPercent()<BR ALIGN="LEFT"/>getMatchingFragments()<BR ALIGN="LEFT"/>isFlagged()<BR ALIGN="LEFT"/>HIGHEST_FIRST: Comparator<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ReportGenerator" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f1fb"><TR><TD><B>ReportGenerator</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT">writeReport(results, file)<BR ALIGN="LEFT"/>toText(results): String<BR ALIGN="LEFT"/>toCsv(results): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ResultStore" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f1fb"><TR><TD><B>ResultStore</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT">save(results, file)<BR ALIGN="LEFT"/>load(file): List&lt;SimilarityResult&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Logger" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f1eefa"><TR><TD><B>Logger</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-logFile: Path<BR ALIGN="LEFT"/>-echoToConsole: boolean<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">info(msg)<BR ALIGN="LEFT"/>warn(msg)<BR ALIGN="LEFT"/>error(msg)<BR ALIGN="LEFT"/>getEntries()<BR ALIGN="LEFT"/>count(level)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"InvalidSourceFileException" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f1eefa"><TR><TD><B>InvalidSourceFileException</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-path: Path<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">getPath()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RankedList<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff6df"><TR><TD><B>RankedList&lt;T&gt;</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-items: Object[]<BR ALIGN="LEFT"/>-size: int<BR ALIGN="LEFT"/>-order: Comparator<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">add(item)<BR ALIGN="LEFT"/>get(i)<BR ALIGN="LEFT"/>top(n)<BR ALIGN="LEFT"/>toList()<BR ALIGN="LEFT"/>iterator()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Pair<A,B>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff6df"><TR><TD><B>Pair&lt;A,B&gt;</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-first: A<BR ALIGN="LEFT"/>-second: B<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">of(first, second)<BR ALIGN="LEFT"/>getFirst()<BR ALIGN="LEFT"/>getSecond()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Main" -> "CLI" [arrowhead=vee style=dashed label="creates"];
"Main" -> "ComparisonService" [arrowhead=vee style=dashed label="creates"];
"Main" -> "ReportGenerator" [arrowhead=vee style=dashed label="DISCLAIMER"];
"CLI" -> "ComparisonService" [arrowhead=vee label="1"];
"CLI" -> "ReportGenerator" [arrowhead=vee label="1"];
"ComparisonService" -> "FileReader" [arrowhead=odiamond label="1"];
"ComparisonService" -> "CodeProcessor" [arrowhead=odiamond label="1"];
"ComparisonService" -> "CodeTokenizer" [arrowhead=odiamond label="1"];
"ComparisonService" -> "SimilarityChecker" [arrowhead=odiamond label="1"];
"ComparisonService" -> "Logger" [arrowhead=odiamond label="1"];
"FileReader" -> "Logger" [arrowhead=vee label=""];
"FileReader" -> "CodeFile" [arrowhead=vee style=dashed label="creates"];
"FileReader" -> "InvalidSourceFileException" [arrowhead=vee style=dashed label="throws"];
"CodeProcessor" -> "CodeFile" [arrowhead=vee style=dashed label="reads"];
"SimilarityChecker" -> "SimilarityResult" [arrowhead=vee style=dashed label="creates"];
"SimilarityChecker" -> "RankedList<T>" [arrowhead=vee style=dashed label="parallel merge"];
"SimilarityChecker" -> "Pair<A,B>" [arrowhead=vee style=dashed label="pair indices"];
"SimilarityResult" -> "CodeFile" [arrowhead=odiamond label="2"];
"ReportGenerator" -> "SimilarityResult" [arrowhead=vee style=dashed label=""];
"ResultStore" -> "SimilarityResult" [arrowhead=vee style=dashed label="serializes"];
}